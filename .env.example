# ============================================================
# Copier en .env puis adapter :  cp .env.example .env
# Ce fichier .env n'est pas versionne (voir .gitignore).
# ============================================================

# ---------- Secret de signature des jetons JWT ----------
# OBLIGATOIRE. 32 caracteres minimum : auth-service et le gateway refusent
# de demarrer si ce secret est absent ou trop court.
# Generer une valeur propre avec :  openssl rand -base64 48
JWT_SECRET=changez-moi-ce-secret-de-developpement-de-48-caracteres-minimum
JWT_EXPIRATION=86400000

# ---------- PostgreSQL (auth, stock, orders, payments) ----------
POSTGRES_USER=gestionstock
POSTGRES_PASSWORD=changez-moi-en-production
# Port expose sur la machine hote (5432 est souvent deja pris localement)
POSTGRES_HOST_PORT=5433

# ---------- MongoDB (customer, notification) ----------
MONGO_USERNAME=gestionstock
MONGO_PASSWORD=changez-moi-en-production

# ---------- Compte administrateur initial ----------
# Laisser vide pour qu'un mot de passe aleatoire soit genere et affiche
# une seule fois dans les logs d'auth-service au premier demarrage.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gestionstock.local
ADMIN_INITIAL_PASSWORD=

# ---------- Profil Spring ----------
# "dev" cree en plus les 7 comptes de demonstration (un par role).
# Toute autre valeur (ex. "prod") ne cree que le compte administrateur ci-dessus.
SPRING_PROFILES_ACTIVE=dev

# ---------- Outils d'administration optionnels ----------
# Demarres uniquement avec :  docker compose --profile tools up
PGADMIN_DEFAULT_EMAIL=admin@gestionstock.local
PGADMIN_DEFAULT_PASSWORD=changez-moi
